# Normalise line endings; keep scripts runnable on every platform.
* text=auto
*.sh text eol=lf
*.cs text diff=csharp
*.md text
*.json text
*.asmdef text
*.shader text
*.hlsl text
*.cginc text

# Unity YAML assets are text; use the Unity smart merge when configured
# (git config merge.unityyamlmerge.driver "'<UnityYAMLMerge path>' merge -p %O %B %A %A").
*.unity     text eol=lf linguist-language=yaml merge=unityyamlmerge
*.prefab    text eol=lf linguist-language=yaml merge=unityyamlmerge
*.asset     text eol=lf linguist-language=yaml merge=unityyamlmerge
*.mat       text eol=lf linguist-language=yaml merge=unityyamlmerge
*.anim      text eol=lf linguist-language=yaml merge=unityyamlmerge
*.controller text eol=lf linguist-language=yaml merge=unityyamlmerge
*.meta      text eol=lf linguist-language=yaml
*.inputactions text eol=lf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.fbx  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.dll  binary

