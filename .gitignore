*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
TestResults*.xml

# ---------------------------------------------------------------------------
# Unity "Get Started" template content that Clean Time does not use.
# ~250 MB of tutorial videos, sample textures, a robot and a demo scene.
# Kept on disk if present, but not committed. Delete the folders any time.
# ---------------------------------------------------------------------------
/Assets/Tutorials/
/Assets/Tutorials.meta
/Assets/Scenes/
/Assets/Scenes.meta
/Assets/Prefabs/
/Assets/Prefabs.meta
/Assets/Materials/
/Assets/Materials.meta
/Assets/VFX/
/Assets/VFX.meta
/Assets/Audio/
/Assets/Audio.meta
/Assets/Skyboxes/
/Assets/Skyboxes.meta
/Assets/UI/
/Assets/UI.meta
/Assets/SourceFiles/*
# ...except the two parts the project settings still point at:
#   Settings    -> the URP render pipeline assets (Graphics / Quality settings)
#   InputSystem -> the project-wide Input System actions asset (EditorBuildSettings)
!/Assets/SourceFiles/Settings/
!/Assets/SourceFiles/Settings.meta
!/Assets/SourceFiles/InputSystem/
!/Assets/SourceFiles/InputSystem.meta

# NOTE: do not ignore *.meta files or Assets/TextMesh Pro (TMP essentials are required by the UI views).
