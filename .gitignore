# Secrets and machine-specific files (never commit)
# ---------------------------------------------------------------------------
.env
.env.*
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
google-services.json
GoogleService-Info.plist
